# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.

# Database (Neon PostgreSQL)
# Get from https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: separate URL for production branch (used by ops scripts in /scripts/db)
# DATABASE_URL_PROD="postgresql://user:password@host/dbname?sslmode=require"

# Site URL — must match your live domain, no trailing slash
NEXT_PUBLIC_SITE_URL="https://nusabeetrip.com"

# Search engine verification codes (leave empty until you have them)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""

# Email service (Resend) — required if you wire up the contact form
RESEND_API_KEY=""
FROM_EMAIL="noreply@example.com"
TO_EMAIL="owner@example.com"

# Google Analytics / Google Ads (optional, but required for SEM measurement)
# Use a Google tag destination such as G-XXXXXXXXXX or GT-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_TAG_ID=""
# Use the full Google Ads send_to value, for example AW-123456789/AbCdEf.
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION=""
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION=""
NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION=""

# Google Business Profile identity and direct-review URLs are tied to the
# verified NusaBeeTrip Place ID in src/lib/site-config.ts. Do not replace them
# with a broad Google Maps search URL.

# Server-only key used by /api/google-reviews to read up to five relevant
# reviews through Places API (New). Enable billing, restrict the key to Places
# API (New), configure quotas/budget alerts, and never prefix this with
# NEXT_PUBLIC_. Google Places content is fetched live and is not stored locally.
GOOGLE_PLACES_API_KEY=""
# Deliberate production opt-in. Set true only after a hard API quota and route
# rate limiting/WAF rule have been configured to control paid request volume.
GOOGLE_REVIEWS_ENABLED="false"

# Social / third-party profiles — emitted into JSON-LD sameAs.
# Leave blank if you don't have a profile yet; only filled values are used.
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_TRIPADVISOR_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""


# Admin panel
# Set a strong password — this protects /admin. Never commit the real value.
ADMIN_PASSWORD=""
# Optional: separate signing key for the session cookie. If empty, the
# password is used as the signing key. Set a long random string in production.
ADMIN_SESSION_SECRET=""

